# Root-level ignores for the parent repo.
# App-specific Python/Node artifacts are handled by each subproject's .gitignore.

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
secrets/

# Logs and runtime files
logs/
*.log
*.out
*.err
*.pid
*.pid.lock

# Coverage, caches, and test artifacts
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
coverage/
htmlcov/

# Dependency and build tooling
node_modules/
dist/
build/
.venv/
venv/
env/

# Infrastructure state
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
docker-data/**
!docker-data/
!docker-data/**/
!docker-data/**/.gitkeep

# Editors and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
docker-data/identity-server/postgres

# Kubeseal — local CLI binary, never commit to Git
kubeseal.exe
kubeseal
kubeseal.tar.gz
mkcert.exe
mkcert
mkcert.tar.gz

# Temporary plain-text secret files created before sealing
# NEVER commit these — they contain raw passwords!
temp-*.yaml
plain.yaml
plain*.yaml

